{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WinFlow",
  "version": "0.2.1",
  "identifier": "com.winflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinFlow",
        "width": 370,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true,
        "visible": false
      },
      {
        "label": "picker",
        "title": "WinFlow Color Picker",
        "fullscreen": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RTg0N0MxODlFNUZCNkEKUldScSsrV0p3VWZvRnQrTDdjODlCV2pKbVRUbk9panJ3dVhsbUluTzNQYmp5eGlmMjBGaVVqYkMK",
      "endpoints": [
        "https://github.com/ramizmortada/WinFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
